# Copy this file to .env and insert YOUR OWN SECRET tokens.
# Do not publish the .env file or paste its values into a chat.
TELEGRAM_BOT_TOKEN=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Used automatically only when the primary Gemini model is temporarily unavailable.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional Telegram sticker file_id, sent once with the personal-chat welcome.
WELCOME_STICKER_ID=
# Optional alternative: set AI_PROVIDER=openai to use these settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. Start the bot and send /myid from your own Telegram account.
# Required for personal-account auto replies; also enables /operator.
# Put YOUR OWN ID here and restart bot.py.
ADMIN_TELEGRAM_ID=

# ai: AI answers, with a fixed reply if AI is unavailable.
# static: fixed replies only; business chats do not call an AI provider.
BUSINESS_REPLY_MODE=ai
AUTO_REPLY_TEXT="Assalomu alaykum! Bu avtomatik javob. Xabaringiz qabul qilindi. Iltimos, javobni kuting."

# Delayed Telegram updates older than this do not receive an automatic reply.
MAX_AUTO_REPLY_AGE_SECONDS=900
# Local message history, alerts and daily-greeting records older than this are removed at startup.
DATA_RETENTION_DAYS=60
