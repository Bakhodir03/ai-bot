[Unit]
Description=Bahodir Telegram AI Helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegrambot
Group=telegrambot
WorkingDirectory=/opt/telegram-ai-bot
EnvironmentFile=/etc/telegram-ai-bot.env
ExecStart=/opt/telegram-ai-bot/.venv/bin/python bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/telegram-ai-bot/data

[Install]
WantedBy=multi-user.target
